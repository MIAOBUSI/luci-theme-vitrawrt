{%
	const luciProjectUrl = version.luciurl ?? '#';
	const distroProjectUrl = version.disturl ?? '#';
-%}

		{% if (!blank_page): %}
			</main>
			<footer class="vwrt-footer">
				<div class="vwrt-footer-inner">
					<span>
						{{ _('Powered by') }}
						<a href="{{ entityencode(luciProjectUrl, true) }}" target="_blank" rel="noreferrer">
							{{ version.luciname }} ({{ version.luciversion }})</a>
						/
						<a href="{{ entityencode(distroProjectUrl, true) }}" target="_blank" rel="noreferrer">
							{{ version.distname }} {{ version.distversion }} ({{ version.distrevision }})</a>
						{% if (lua_active): %}
							/ {{ _('Lua compatibility mode active') }}
						{% endif %}
					</span>
					<ul id="modemenu" style="display:none"></ul>
				</div>
			</footer>
		</div>
		<script>L.require('menu-vitrawrt')</script>
		{% endif %}
	</body>
</html>
